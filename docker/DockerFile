FROM golang:1.25.6-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go.mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o app cmd/api/main.go

FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/bin/e-commerce-api .
COPY --from=builder /app/migrations ./migrations
RUN apk add --no-cache bash curl
RUN curl -L https://github.com/golang-migrate/migrate/releases/download/v4.16.2/migrate.linux-amd64.tar.gz \
    | tar xvz \
    && mv migrate.linux-amd64 /usr/local/bin/migrate

CMD ["./e-commerce-api"]
